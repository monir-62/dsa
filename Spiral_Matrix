#include<iostream>
using namespace std;
void prin(int arr[][3],int m,int n){
    int sr=0;
    int sc=0;
    int er=m-1;
    int ec=n-1;
    while(sr<=er && sc<=ec){
        for(int j=sc;j<=ec;j++){//top
            cout<<arr[sr][j]<<" ";
        }
        for(int i=sr+1;i<=er;i++){//right
            cout<<arr[i][ec]<<" ";
        }
        for(int j=ec-1;j>=sc;j--){//bottom
            if(sr==er){
                break;
            }
            cout<<arr[er][j]<<" ";
        }
        for(int i=er-1;i>=sr+1;i--){//left
            if(sr==er){
                break;
            }
            cout<<arr[i][sc]<<" ";
        }
        sr++;
        sc++;
        er--;
        ec--;
    }

}
int main(){
    int arr[3][3]={{1,2,3},
                    {4,5,6},
                    {7,8,9}};
    prin(arr,3,3);
    cout<<endl;
    return 0;
}
